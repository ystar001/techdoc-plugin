    {"id": "S04", "wrong": "그 동안", "right": "그동안", "re": "(?<![가-힣])그 동안", "except": [], "basis": "표준국어대사전 표제어 「그동안」(한 낱말)"},
    {"id": "S05", "wrong": "그 때 · 이 때", "right": "그때 · 이때", "re": "(?<![가-힣])[그이] 때(?!문)", "except": [], "basis": "표준국어대사전 표제어 「그때」「이때」(「그 때문에」의 「때문」은 의존 명사라 뺌)"},
    {"id": "S06", "wrong": "그 중", "right": "그중", "re": "(?<![가-힣])그 중(?=[\\s에의은도,.]|$)", "except": [], "basis": "표준국어대사전 표제어 「그중」"},
    {"id": "S07", "wrong": "그 다음", "right": "그다음", "re": "(?<![가-힣])그 다음", "except": [], "basis": "표준국어대사전 표제어 「그다음」"},
    {"id": "S08", "wrong": "할때", "right": "할 때", "re": "{ㄹ받침}때(?=[\\s에는도의만까,.]|$)", "except": ["(?<![가-힣])물때"], "basis": "제42항 — 의존 명사 「때」는 띄어 쓴다(「물때」는 한 낱말)"},
